# Copy this file to Password.properties and fill in the values.

# MySQL host user/password and DB coordinates
host=root
db_name=password_manager
port=3306
pwd=

# Server-wide HMAC-SHA256 key for the searchable "blind index" columns.
# Base64-encoded 32 random bytes. Leave empty on first run, the app will
# generate one and print it. Paste the printed value back into this file.

blind_index_key=
